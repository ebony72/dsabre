-            sorted_qubit_tmp_idx = {qubit : qubits_tmp_idx[qubit] for qubit in quantum_circuit.qubits}
+            # PATCH: skip circuit qubits that don't appear in any DAG op (padding
+            # qubits added when the device has more physical qubits than the
+            # circuit uses).  They have no temp index and would raise KeyError;
+            # they also shouldn't consume initial-partition block capacity.
+            sorted_qubit_tmp_idx = {qubit : qubits_tmp_idx[qubit]
+                                    for qubit in quantum_circuit.qubits
+                                    if qubit in qubits_tmp_idx}
             sorted_tmp_idx = list(sorted_qubit_tmp_idx.values())
             
             tmp_dict = {}
@@ -150,6 +156,23 @@ class QuCircPartitioner:
 
         edges_wgt_dict = {}
         twoQ_ops_blocks = self._find_2q_op_block(dag)
+        # PATCH: pre-seed vers_wgt_dict with every circuit qubit that appears
+        # in ANY DAG op (even single-qubit) at weight 1 so that isolated qubits
+        # -- those that have only single-qubit gates, never appearing in a
+        # 2-qubit block (e.g. the idle Hadamard targets in Bernstein-Vazirani
+        # -- still get a temp index later.  Without this, the line
+        # "sorted_qubit_tmp_idx = {qubit: qubits_tmp_idx[qubit] for qubit in
+        # quantum_circuit.qubits}" in run() raises KeyError.  Padding qubits
+        # (those in the canonical register that no op references) are
+        # intentionally skipped: adding them inflates capacity demand and
+        # trips an IndexError in the initial-partition fill loop.  Weight is
+        # 1 (not 0) because KaHyPar 1.3.7 rejects zero-weight vertices.
+        _dag_used = set()
+        for _node in dag.op_nodes():
+            _dag_used.update(_node.qargs)
+        for _q in _dag_used:
+            if _q not in vers_wgt_dict:
+                vers_wgt_dict[_q] = 1
         # Calculate the weight of node and net
         for ops_block in twoQ_ops_blocks:
             qubits = []
