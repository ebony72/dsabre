{
  "meta": {
    "date": "2026-05-11",
    "router": "dSABRE_BurstExt (dsabre_ext.py)",
    "default_config": {
      "weight_extended": 0.25,
      "cap_penalty": 15.0,
      "hop_gain": 5.0,
      "relief_bonus": 8.0,
      "relief_depth_weight": 0.5,
      "relief_gradient_weight": 1.0,
      "lookahead_size": 20,
      "lookahead_decay": 0.9,
      "layout_passes": 2,
      "inter_core_edge_weight": 10
    },
    "layout": "TeleSABRE Hungarian (reused from results_*.json)",
    "note": "All gmeans are geometric means over per-circuit EPR counts."
  },

  "mechanism_ablation": {
    "suite": "25q",
    "baseline": "full",
    "configs": [
      {"label": "full",           "gmean_eprs": 23.8, "delta_pct": 0.0,   "per_circuit": {"ae":24,"ghz":2,"graphstate":8,"qft":35,"qnn":52,"random":185}},
      {"label": "no_lookahead",   "gmean_eprs": 29.5, "delta_pct": 23.7,  "per_circuit": {"ae":25,"ghz":2,"graphstate":9,"qft":36,"qnn":50,"random":214}, "change": "weight_extended=0.0"},
      {"label": "no_hop_gain",    "gmean_eprs": 23.8, "delta_pct": 0.0,   "per_circuit": {"ae":24,"ghz":2,"graphstate":8,"qft":35,"qnn":52,"random":185}, "change": "hop_gain=0.0"},
      {"label": "no_cap_penalty", "gmean_eprs": 40.7, "delta_pct": 70.8,  "per_circuit": {"ae":25,"ghz":2,"graphstate":9,"qft":36,"qnn":50,"random":214}, "change": "cap_penalty=0.0"},
      {"label": "no_relief",      "gmean_eprs": 23.2, "delta_pct": -2.5,  "per_circuit": {"ae":24,"ghz":2,"graphstate":8,"qft":35,"qnn":52,"random":185}, "change": "enable_congestion_relief=False"}
    ],
    "finding": "cap_penalty and lookahead are load-bearing. hop_gain is redundant. congestion relief hurts marginally on 25q but is critical on 64q (+164% EPR when disabled)."
  },

  "congestion_relief_64q": {
    "suite": "64q",
    "configs": [
      {"label": "relief on",  "gmean_eprs": 110.3, "per_circuit": {"ae":240,"ghz":10,"graphstate":50,"qft":263,"qnn":517}},
      {"label": "relief off", "gmean_eprs": 290.9, "delta_pct": 163.8, "per_circuit": {"ae":403,"ghz":10,"graphstate":50,"qft":3499,"qnn":2957}}
    ],
    "finding": "Congestion relief is essential on 64q. qft and qnn degrade by over 10x without it."
  },

  "weight_extended_sweep": {
    "parameter": "weight_extended",
    "default": 0.25,
    "previous_default": 0.5,
    "suites": {
      "25q": [
        {"value": 0.0,  "gmean_eprs": 29.5, "delta_pct_vs_default": 31.1},
        {"value": 0.1,  "gmean_eprs": 22.6, "delta_pct_vs_default": 0.4},
        {"value": 0.25, "gmean_eprs": 22.5, "delta_pct_vs_default": 0.0},
        {"value": 0.5,  "gmean_eprs": 23.8, "delta_pct_vs_default": 5.8},
        {"value": 1.0,  "gmean_eprs": 38.3, "delta_pct_vs_default": 70.2},
        {"value": 2.0,  "gmean_eprs": 77.2, "delta_pct_vs_default": 243.1}
      ],
      "36q": [
        {"value": 0.5,  "gmean_eprs": 14.5, "note": "old default"},
        {"value": 0.25, "gmean_eprs": 13.9, "delta_pct_vs_old": -4.0}
      ],
      "64q": [
        {"value": 0.5,  "gmean_eprs": 117.5, "note": "old default"},
        {"value": 0.25, "gmean_eprs": 110.3, "delta_pct_vs_old": -6.2}
      ]
    },
    "action": "Default changed from 0.5 to 0.25. Improvement: 25q -5.6%, 36q -4.0%, 64q -6.2%.",
    "finding": "Strongly asymmetric: too-high weight_extended catastrophic (>2x EPR at w=2.0), too-low only mildly bad. Optimum at 0.25."
  },

  "cap_penalty_sweep": {
    "parameter": "cap_penalty",
    "default": 15.0,
    "suite": "25q",
    "values": [
      {"value": 0.0,  "gmean_eprs": 40.7, "delta_pct": 70.8},
      {"value": 5.0,  "gmean_eprs": 28.6, "delta_pct": 20.1},
      {"value": 15.0, "gmean_eprs": 23.8, "delta_pct": 0.0},
      {"value": 30.0, "gmean_eprs": 23.3, "delta_pct": -2.1},
      {"value": 60.0, "gmean_eprs": 23.7, "delta_pct": -0.4}
    ],
    "finding": "Default 15 sits at the knee of the curve. All values >= 15 are within 2% of optimal. No change needed."
  },

  "inter_core_edge_weight_sweep": {
    "parameter": "inter_core_edge_weight (architecture.py)",
    "default": 10,
    "suite": "25q",
    "values": [
      {"value": 1,  "gmean_eprs": 24.8, "gmean_ls": 276.2},
      {"value": 3,  "gmean_eprs": 23.3, "gmean_ls": 276.3},
      {"value": 5,  "gmean_eprs": 22.7, "gmean_ls": 266.8},
      {"value": 7,  "gmean_eprs": 23.0, "gmean_ls": 277.6},
      {"value": 10, "gmean_eprs": 22.5, "gmean_ls": 240.7},
      {"value": 15, "gmean_eprs": 22.8, "gmean_ls": 245.4},
      {"value": 20, "gmean_eprs": 23.7, "gmean_ls": 271.4},
      {"value": 25, "gmean_eprs": 23.5, "gmean_ls": 275.0},
      {"value": 30, "gmean_eprs": 23.4, "gmean_ls": 270.8},
      {"value": 50, "gmean_eprs": 32.0, "gmean_ls": 280.0}
    ],
    "finding": "w=10 is optimal for both EPR and SWAP simultaneously. Flat bowl 5-15. w=50 breaks ae circuit (24->130 EPR). Matches cost_teleport=10 — physically motivated."
  },

  "lookahead_size_sweep": {
    "parameter": "lookahead_size",
    "default": 20,
    "suites": {
      "25q": [
        {"value": 5,  "gmean_eprs": 24.2, "delta_pct": 7.6},
        {"value": 10, "gmean_eprs": 22.6, "delta_pct": 0.4},
        {"value": 15, "gmean_eprs": 22.8, "delta_pct": 1.3},
        {"value": 20, "gmean_eprs": 22.5, "delta_pct": 0.0},
        {"value": 30, "gmean_eprs": 22.7, "delta_pct": 0.7},
        {"value": 50, "gmean_eprs": 22.5, "delta_pct": -0.1}
      ],
      "64q": [
        {"value": 5,  "gmean_eprs": 115.8, "delta_pct": 5.0},
        {"value": 10, "gmean_eprs": 122.1, "delta_pct": 10.7},
        {"value": 15, "gmean_eprs": 114.9, "delta_pct": 4.2},
        {"value": 20, "gmean_eprs": 110.3, "delta_pct": 0.0},
        {"value": 30, "gmean_eprs": 111.8, "delta_pct": 1.4},
        {"value": 50, "gmean_eprs": 112.0, "delta_pct": 1.5}
