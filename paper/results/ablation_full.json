    "finding": "Default 20 is at or near the minimum on both suites. Sizes 15-50 all within 5%. size=5 is the only clearly inferior choice. No change needed."
  },

  "lookahead_decay_sweep": {
    "parameter": "lookahead_decay",
    "default": 0.9,
    "suites": {
      "25q": [
        {"value": 0.5,  "gmean_eprs": 24.9, "delta_pct": 10.7},
        {"value": 0.7,  "gmean_eprs": 22.9, "delta_pct": 1.8},
        {"value": 0.8,  "gmean_eprs": 22.6, "delta_pct": 0.4},
        {"value": 0.9,  "gmean_eprs": 22.5, "delta_pct": 0.0},
        {"value": 0.95, "gmean_eprs": 22.9, "delta_pct": 1.8},
        {"value": 1.0,  "gmean_eprs": 22.8, "delta_pct": 1.3}
      ],
      "64q": [
        {"value": 0.5,  "gmean_eprs": 120.5, "delta_pct": 9.3},
        {"value": 0.7,  "gmean_eprs": 107.7, "delta_pct": -2.4},
        {"value": 0.8,  "gmean_eprs": 122.1, "delta_pct": 10.7},
        {"value": 0.9,  "gmean_eprs": 110.3, "delta_pct": 0.0},
        {"value": 0.95, "gmean_eprs": 109.6, "delta_pct": -0.6},
        {"value": 1.0,  "gmean_eprs": 118.0, "delta_pct": 7.0}
      ]
    },
    "finding": "decay=0.9 near-optimal on 25q (flat bowl 0.7-0.95). 64q non-monotone landscape; decay=1.0 (flat) clearly worse (+7%), confirming BFS-layer discounting is meaningful. No change needed."
  },

  "layout_passes_sweep": {
    "parameter": "layout_passes",
    "default": 2,
    "strategy": "forward-only (each pass feeds final layout to next)",
    "suites": {
      "25q": [
        {"passes": 1, "gmean_eprs": 24.5, "gmean_ls": 297.5, "delta_pct": 8.9},
        {"passes": 2, "gmean_eprs": 22.5, "gmean_ls": 240.7, "delta_pct": 0.0},
        {"passes": 3, "gmean_eprs": 22.5, "gmean_ls": 240.7, "delta_pct": 0.0},
        {"passes": 4, "gmean_eprs": 22.5, "gmean_ls": 240.7, "delta_pct": 0.0}
      ],
      "64q": [
        {"passes": 1, "gmean_eprs": 113.9, "gmean_ls": 1096.8, "delta_pct": 3.3},
        {"passes": 2, "gmean_eprs": 110.3, "gmean_ls": 1096.1, "delta_pct": 0.0},
        {"passes": 3, "gmean_eprs": 110.2, "gmean_ls": 1113.8, "delta_pct": -0.0},
        {"passes": 4, "gmean_eprs": 110.2, "gmean_ls": 1117.2, "delta_pct": -0.1}
      ]
    },
    "finding": "Pass 1->2 is the only meaningful step (25q: -8.9% EPR -19% SWAP; 64q qnn: 608->517). Pass 3+ triggers early stopping — no further improvement. Default of 2 is exactly right."
  },

