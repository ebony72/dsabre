          "ae":        {"fwd2": 24, "sabre": 22},
          "ghz":       {"fwd2": 2,  "sabre": 2},
          "graphstate":{"fwd2": 8,  "sabre": 4},
          "qft":       {"fwd2": 35, "sabre": 33},
          "qnn":       {"fwd2": 52, "sabre": 49},
