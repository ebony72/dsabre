        "fwd2_gmean": 110.3,
        "sabre_gmean": 98.4,
        "delta_pct": -10.8,
        "per_circuit": {
          "ae":        {"fwd2": 240, "sabre": 240},
          "ghz":       {"fwd2": 10,  "sabre": 8},
          "graphstate":{"fwd2": 50,  "sabre": 30},
          "qft":       {"fwd2": 263, "sabre": 263},
          "qnn":       {"fwd2": 517, "sabre": 608}
        }
      }
    },
    "finding": "SABRE-style passes improve gmean substantially (25q -14.2%, 64q -10.8%) but qnn on 64q regresses +17.6%. Needs further investigation before adoption. Initial mapping investigation deferred."
  },

